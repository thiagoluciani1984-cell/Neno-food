# ─── Nenos Food — variáveis de ambiente (desenvolvimento local) ─
# Copie: cp .env.local.example .env.local
# Referência completa: docs/ENVIRONMENT.md

# ─── Supabase (obrigatório) ─────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — NUNCA exponha no cliente (server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App (obrigatório) ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=lucianis-di-qualita

# ─── Asaas (pagamento online / PIX) ──────────────────────────
# Sandbox: sandbox.asaas.com → Configurações → Integração → Chave de API
ASAAS_API_KEY=
ASAAS_SANDBOX=true

# Split marketplace (opcional) — % que fica com a plataforma, restante vai
# pro asaas_wallet_id do restaurante (Dashboard → Configurações)
ASAAS_PLATFORM_FEE_PERCENT=10

# Webhook — URL: https://SEU-DOMINIO/api/payments/asaas/webhook
ASAAS_WEBHOOK_TOKEN=

# Mock dev: testa PIX online sem chave real (NUNCA em produção)
ASAAS_DEV_MOCK=true

# Monitoramento opcional (Sentry)
# SENTRY_DSN=https://key@o0.ingest.sentry.io/project-id

# ─── Scripts de banco (terminal only, não commitar) ─────────
# PGPW=sua-senha-postgres
# PROJECT_REF=seu-project-ref
